OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_KEEP_ALIVE=30m
NUM_CTX=4096
REQUEST_TIMEOUT=120
MAX_CONCURRENT_GENERATIONS=2
CORS_ORIGINS=["http://localhost:5173"]

# Database: "sqlite" (default, nothing to install) or "postgres" (see docker-compose.yml)
DB_MODE=sqlite
SQLITE_PATH=data/english_coach.db
POSTGRES_USER=english_coach
POSTGRES_PASSWORD=english_coach
POSTGRES_DB=english_coach
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default
PIPER_VOICE_PATH=models/piper/en_US-lessac-medium.onnx
